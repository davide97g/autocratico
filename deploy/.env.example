# Settings for deploy/compose.yml: copy to deploy/.env and fill in. Every variable: docs/configuration.md.

# Required: the HTTPS address the app is reached at (your reverse proxy or tunnel serves it).
PUBLIC_ORIGIN=https://autocratico.example.com

# Claude for the chat and the background agent: one of the two.
#   a Claude subscription: run `claude setup-token` on any computer and paste the token
CLAUDE_CODE_OAUTH_TOKEN=
#   or an Anthropic API key (billed per use)
ANTHROPIC_API_KEY=

# Where the register lives on the host (default: data/ next to deploy/, the same folder ./setup.sh uses).
# The container runs as uid 1000: `sudo chown -R 1000:1000` the folders the first time.
# AUTOCRATICO_DATA_DIR=/srv/autocratico/data
# AUTOCRATICO_BACKUP_DIR=/srv/autocratico/backups

# Time zone of the deadlines and the jobs, and the language of Telegram, ntfy and the agent (it | en).
TZ=Europe/Rome
AUTOCRATICO_LOCALE=it

# Notifications (optional, any or both).
TELEGRAM_BOT_TOKEN=
#   ntfy: a long random topic on ntfy.sh, or your own server (docs/ntfy.md)
NTFY_URL=
NTFY_TOKEN=
# Other registers to switch to, one instance each (docs/self-hosting.md, "More than one person"):
# AUTOCRATICO_REGISTERS=Name=https://other.example.com

# Cloudflare Access (optional): with deploy/compose.cloudflare.yml.
CF_ACCESS_TEAM=
CF_ACCESS_AUD=

# Voice messages transcribed on the server (optional): with deploy/compose.asr.yml.
# AUTOCRATICO_ASR_DIR=/srv/autocratico/asr

# Scheduled jobs (Gmail sync, triage, reminders, digest, backup) run by default; off to pause them.
# AUTOCRATICO_JOBS=on
